# ============================================================
# EasyCode 环境变量示例
# 复制本文件为 .env，填入真实值后使用
# ============================================================

# ── LLM API Keys ─────────────────────────────────────────
# 至少配置一个，推荐 Deepseek（价格低，适合开发调试）
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=sk-...

# ── 默认模型配置 ──────────────────────────────────────────
# 可选值: openai/gpt-4o | anthropic/claude-3-5-sonnet | deepseek/deepseek-chat
EASYCODE_DEFAULT_MODEL=deepseek/deepseek-chat

# ── 日志级别 ─────────────────────────────────────────────
# 可选值: debug | info | warn | error
EASYCODE_LOG_LEVEL=info

# ── 会话存储路径（默认 ~/.easycode）────────────────────────
# EASYCODE_SESSION_DIR=/custom/path/.easycode

# ── 上下文窗口配置 ───────────────────────────────────────
# token 超过此比例时触发上下文压缩（0-1）
EASYCODE_COMPACTION_THRESHOLD=0.8

# ── 安全审批策略 ─────────────────────────────────────────
# 可选值: ask（默认，危险命令弹窗确认）| auto（全部放行）| never（只读模式）
EASYCODE_APPROVAL_POLICY=ask

# ── MCP Server（可选）────────────────────────────────────
# 格式: stdio:<command> 或 http:<url>
# EASYCODE_MCP_SERVER=stdio:node mcp-server.js
